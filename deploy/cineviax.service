[Unit]
Description=CineviaXMovieBot Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/opt/cineviax
EnvironmentFile=/opt/cineviax/.env
ExecStart=/opt/cineviax/.venv/bin/python /opt/cineviax/main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
